{
	"name": "@sv-addon/utils",
	"version": "0.0.0",
	"type": "module",
	"bin": {
		"sv-addon-sync-template": "./src/scripts/sync-template.ts"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsgo",
		"publint": "publint",
		"gen:type": "node src/scripts/registry-types.ts",
		"gen:schema": "node src/scripts/emit-schema.ts",
		"test": "echo \"Error: no test specified\" && exit 1",
		"postinstall": "npm run gen:type && npm run gen:schema",
		"prepublish": "npm run build"
	},
	"exports": {
		".": "./src/index.ts",
		"./build": "./src/build.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"peerDependencies": {
		"@sveltejs/sv-utils": "catalog:addons",
		"@types/estree": "^1.0.9"
	},
	"devDependencies": {
		"@valibot/to-json-schema": "^1.7.1",
		"degit": "catalog:ci",
		"openapi-fetch": "^0.17.0",
		"openapi-typescript": "^7.13.0",
		"publint": "catalog:ci",
		"sucrase": "^3.35.1",
		"tsdown": "catalog:ci",
		"valibot": "catalog:lint",
		"wellcrafted": "catalog:lint"
	},
	"author": "Scott Wu <sw@scottwu.ca>",
	"keywords": [
		"sv-add",
		"svelte",
		"util"
	],
	"description": "Shared utilities for @sv-addon repos",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sacrosanctic/sv-addon.git",
		"directory": "packages/utils"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": "./dist/index.mjs",
			"./build": "./dist/build.mjs",
			"./package.json": "./package.json"
		},
		"bin": {
			"sv-addon-sync-template": "./dist/sync-template.mjs"
		}
	},
	"inlinedDependencies": {
		"@jridgewell/gen-mapping": "0.3.13",
		"@jridgewell/resolve-uri": "3.1.2",
		"@jridgewell/sourcemap-codec": "1.5.5",
		"@jridgewell/trace-mapping": "0.3.31",
		"@valibot/to-json-schema": "1.7.1",
		"degit": "3.9.0",
		"lines-and-columns": "1.2.4",
		"openapi-fetch": "0.17.0",
		"sucrase": "3.35.1",
		"ts-interface-checker": "0.1.13",
		"valibot": "1.4.2"
	}
}
