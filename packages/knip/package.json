{
	"name": "@sacrosanctic/addon/knip",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"demo-add": "pnpm build && sv add file:../ --cwd demo --no-git-check --no-install",
		"demo-add:ci": "pnpm build && sv add file:../=who:you --cwd demo --no-git-check --no-download-check --no-install",
		"demo-create": "sv create demo --types ts --template minimal --no-add-ons --no-install",
		"prepublishOnly": "npm run build",
		"test": "vitest run"
	},
	"exports": {
		".": {
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/sv-utils": "^0.3.1",
		"@types/node": "^25.9.1",
		"sv": "^0.16.3",
		"tsdown": "^0.22.1",
		"unrun": "^0.2.39",
		"vitest": "^4.1.8"
	},
	"peerDependencies": {
		"sv": "^0.16.3"
	},
	"license": "MIT",
	"keywords": [
		"sv-add",
		"svelte",
		"sveltekit"
	],
	"description": "sv add-on for @sacrosanctic/knip",
	"publishConfig": {
		"access": "public"
	}
}
