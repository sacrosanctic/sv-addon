{
	"name": "@sv-addon/svelte-meta-tags",
	"version": "0.0.2",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"demo-add": "pnpm build && sv add file:../ --cwd demo --no-git-check --no-install",
		"demo-add:ci": "pnpm build && sv add file:../=title:My+Site&description:A+great+site --cwd demo --no-git-check --no-download-check --no-install",
		"demo-create": "sv create demo --types ts --template minimal --no-add-ons --no-install",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"prepublishOnly": "npm run build",
		"test": "vitest run"
	},
	"exports": {
		".": {
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/sv-utils": "^0.3.1",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sv": "^0.16.3",
		"tsdown": "^0.22.1",
		"unrun": "^0.2.39",
		"vitest": "^4.1.8",
		"zimmerframe": "^1.1.4"
	},
	"peerDependencies": {
		"sv": "^0.16.3"
	},
	"license": "MIT",
	"keywords": [
		"sv-add",
		"svelte",
		"sveltekit"
	],
	"description": "sv add-on for svelte-meta-tags SEO component",
	"publishConfig": {
		"access": "public"
	}
}
