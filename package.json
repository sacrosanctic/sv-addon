{
	"name": "sv-addon",
	"type": "module",
	"private": true,
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": ">=11.0.0 <12.0.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": ">=22.20",
			"onFail": "error"
		}
	},
	"scripts": {
		"build": "pn -r build",
		"format": "prettier --write . && eslint . --fix && knip --fix",
		"check": "pn -r check",
		"knip": "knip",
		"lint": "prettier --check . && eslint .",
		"publint": "pn -r publint"
	},
	"devDependencies": {
		"@eslint/js": "catalog:lint",
		"@types/node": "catalog:types",
		"@typescript/native-preview": "catalog:types",
		"eslint": "catalog:lint",
		"eslint-config-prettier": "catalog:lint",
		"eslint-plugin-jsonc": "catalog:lint",
		"eslint-plugin-perfectionist": "catalog:lint",
		"globals": "catalog:types",
		"knip": "catalog:lint",
		"prettier": "catalog:lint",
		"prettier-plugin-svelte": "catalog:lint",
		"typescript": "catalog:types"
	}
}
